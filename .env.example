# Copy to .dev.vars for local development. Never commit credentials.
# All integrations are optional. Rule-based drafts work with no keys.
MEETSTREAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Linear personal API key, team UUID, and exact speaker-to-user UUID mapping.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_ASSIGNEES={"Sarah Chen":"linear-user-uuid","James Wilson":"linear-user-uuid"}

# Fine-grained token with repository Issues:write and Metadata:read.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_ASSIGNEES={"Sarah Chen":"github-login","James Wilson":"github-login"}

# Incoming webhook for the intended team channel.
SLACK_WEBHOOK_URL=

# Share the parent page with the Notion integration.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
